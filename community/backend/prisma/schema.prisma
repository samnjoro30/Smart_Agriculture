generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["community"]
}

model CommunityCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  discussions Discussion[]

  @@schema("community")
}

model Discussion {
  id         String            @id @default(cuid())
  title      String
  body       String
  authorId   String
  status     DiscussionStatus  @default(OPEN)
  categoryId String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  category   CommunityCategory @relation(fields: [categoryId], references: [id])
  likes      DiscussionLike[]
  replies    Reply[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@schema("community")
}

model Reply {
  id           String     @id @default(cuid())
  message      String
  authorId     String
  discussionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  replyToId    String?
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  replyTo      Reply?     @relation("ReplyReference", fields: [replyToId], references: [id])
  childReplies Reply[]    @relation("ReplyReference")

  @@index([discussionId])
  @@index([authorId])
  @@index([replyToId])
  @@schema("community")
}

model DiscussionLike {
  id           String     @id @default(cuid())
  discussionId String
  userId       String
  createdAt    DateTime   @default(now())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
  @@schema("community")
}

enum DiscussionStatus {
  OPEN
  RESOLVED
  CLOSED

  @@schema("community")
}
